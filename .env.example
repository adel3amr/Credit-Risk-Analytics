# Local reference deployment only. Generate two different hex secrets; do not commit real values.
POSTGRES_PASSWORD=replace_with_random_hex_owner_password
APP_DB_PASSWORD=replace_with_different_random_hex_app_password
# Copilot defaults to the local deterministic provider and sends no data externally.
COPILOT_PROVIDER=deterministic
# Optional external provider requires explicit opt-in plus an HTTPS endpoint and secret.
# COPILOT_ALLOW_EXTERNAL=false
# COPILOT_EXTERNAL_ENDPOINT=https://provider.example/v1/grounded-answer
# COPILOT_EXTERNAL_API_KEY=set_in_secret_manager


# Optional governed OpenAI Copilot. Deterministic local provider remains the default.
# COPILOT_PROVIDER=openai
# OPENAI_API_KEY=replace-with-secret-from-environment
# OPENAI_COPILOT_MODEL=gpt-5.6-luna
# Optional local Ollama provider; governed deterministic facts remain authoritative.
# COPILOT_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2
# OLLAMA_ENDPOINT=http://127.0.0.1:11434/api/generate
# Or use COPILOT_PROVIDER=auto to prefer OpenAI when a key exists, then Ollama when configured.

